# Copy to ~/.config/huckleberry-mcp/env (chmod 600). Never commit real values.

# Huckleberry account the server writes as
HUCKLEBERRY_EMAIL=
HUCKLEBERRY_PASSWORD=
HUCKLEBERRY_TIMEZONE=Australia/Sydney

# Listener (the tunnel forwards the public URL here)
HUCKLEBERRY_MCP_HOST=127.0.0.1
HUCKLEBERRY_MCP_PORT=8765

# Public origin of the tunnel, no path. The connector URL is this plus /mcp
HUCKLEBERRY_MCP_BASE_URL=https://<machine>.<tailnet>.ts.net

# Clerk OAuth application (Dashboard > Configure > OAuth applications)
CLERK_DOMAIN=<instance>.clerk.accounts.dev
CLERK_OAUTH_CLIENT_ID=
CLERK_OAUTH_CLIENT_SECRET=

# Optional second gate: comma-separated emails allowed to use the server
HUCKLEBERRY_MCP_ALLOWED_EMAILS=
